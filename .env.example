# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ser enviado para o repositório.

# Porta do servidor HTTP do backend.
PORT=3000

# Onde os jogadores são guardados:
#   memoria   -> lista em memória (não precisa de Firebase; os dados somem ao reiniciar)
#   firestore -> Cloud Firestore (precisa da credencial abaixo)
BANCO_DADOS=memoria

# Caminho do arquivo JSON da conta de serviço do Firebase
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json
